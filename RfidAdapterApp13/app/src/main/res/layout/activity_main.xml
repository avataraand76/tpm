<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="#FFFFFF"
  tools:context=".MainActivity"
>
  <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="#E0E0E0"
    android:paddingHorizontal="16dp"
  >
    <TextView
      android:id="@+id/txtTenApp"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerVertical="true"
      android:text="RFID Adapter App"
      android:textSize="24sp"
      android:textStyle="bold"
      android:textColor="#333333"
    />

    <ImageButton
      android:id="@+id/btnMenu"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_menu_dots"
      android:contentDescription="Menu"
      app:tint="#333333"
    />
  </RelativeLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
  >
    <TextView
      android:id="@+id/textView3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Trạng thái:"
      android:textSize="20sp"
      android:textColor="#000000"
    />

    <View
      android:id="@+id/viewStatusDot"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginStart="12dp"
      android:layout_marginEnd="12dp"
      android:background="@drawable/bg_status_green"
    />

    <TextView
      android:id="@+id/txtTtrangThai"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Đã kết nối"
      android:textSize="20sp"
      android:textStyle="bold"
      android:textColor="#000000"
    />
  </LinearLayout>

  <Button
    android:id="@+id/btnScan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:text="QUÉT RFID"
    android:textSize="18sp"
    android:backgroundTint="#2196F3"
    android:textColor="#FFFFFF"
  />

  <!-- Thanh công cụ của khung kết quả: 2 nút nằm ngoài vùng text
         để mã EPC dùng được trọn chiều ngang, không bị xuống hàng. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
  >
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Tổng thẻ: "
      android:textSize="16sp"
      android:textColor="#333333"
    />

    <TextView
      android:id="@+id/txtTotalTags"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="0"
      android:textSize="18sp"
      android:textStyle="bold"
      android:textColor="#2196F3"
    />

    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <ImageButton
      android:id="@+id/btnCopy"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:src="@drawable/ic_copy"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="Copy tất cả mã"
      app:tint="#757575"
    />

    <ImageButton
      android:id="@+id/btnClear"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="4dp"
      android:src="@drawable/ic_delete"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="Xóa kết quả"
      app:tint="#757575"
    />
  </LinearLayout>

  <EditText
    android:id="@+id/edtResult"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="16dp"
    android:gravity="top|start"
    android:hint="EPC output..."
    android:padding="10dp"
    android:inputType="textMultiLine"
    android:focusableInTouchMode="true"
    android:longClickable="true"
    android:cursorVisible="false"
    android:background="@android:drawable/edit_text"
    android:fontFamily="monospace"
    android:textSize="17sp"
    android:textColor="#000000"
  />
</LinearLayout>
